<Window x:Class="AlwaysRotate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlwaysRotate"
        mc:Ignorable="d"
        Title="AlwaysRotate"
        Icon="app_icon.ico"
        Height="720" Width="480"
        MinHeight="380" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f13"
        Topmost="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove">

    <Window.Resources>
        <!-- Modern Button Base Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e1e26"/>
            <Setter Property="Foreground" Value="#e4e4e7"/>
            <Setter Property="BorderBrush" Value="#333342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d2d3a"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366f1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171720"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Rotation Button -->
        <Style x:Key="SegmentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Completely Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14141a"/>
            <Setter Property="Foreground" Value="#f4f4f5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252533"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3730a3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="#181820"
                    BorderBrush="#383848"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <!-- Arrow down -->
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="#94a3b8"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#6366f1"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#22222d"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Completely Dark ComboBox ControlTemplate (Fixing White Dropdown Bug) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                <ToggleButton x:Name="toggleButton"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Template="{StaticResource DarkComboBoxToggleButton}"/>
                <ContentPresenter x:Name="contentPresenter"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="12,0,32,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>

                <!-- Deep Dark Popup Container -->
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Slide">
                    <Border x:Name="dropDownBorder"
                            Background="#14141a"
                            BorderBrush="#383848"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,4,0,0"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DropDownScrollViewer"
                                      CanContentScroll="True"
                                      Padding="2">
                            <ItemsPresenter x:Name="ItemsPresenter"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <!-- ComboBox Dark Item Display Template with REAL App Icons -->
        <DataTemplate x:Key="WindowItemTemplate" DataType="{x:Type local:Win32+WindowItem}">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Real Native Application Icon -->
                <Image Grid.Column="0" Source="{Binding RealIcon}" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#262635" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayBadge}" FontSize="9" FontWeight="Bold" Foreground="#a5b4fc"/>
                </Border>
            </Grid>
        </DataTemplate>
        <!-- Fullscreen Floating HUD Button Style -->
        <Style x:Key="HudBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#e4e4e7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Viewport -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar Card -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#14141a" BorderBrush="#262633" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel Orientation="Vertical">

                <!-- Row 1: Target Window Selector, Refresh & Info -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbWindows" Grid.Column="0" Height="36"
                              Template="{StaticResource DarkComboBoxTemplate}"
                              ItemTemplate="{StaticResource WindowItemTemplate}"
                              DropDownOpened="CmbWindows_DropDownOpened"
                              SelectionChanged="CmbWindows_SelectionChanged"
                              Cursor="Hand"/>

                    <Button Grid.Column="1" Click="BtnRefreshWindows_Click" ToolTip="Refrescar lista de ventanas"
                            Style="{StaticResource ModernBtn}" Height="36" Padding="10,0" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnInfo" Grid.Column="2" Click="BtnInfo_Click" ToolTip="Información, Atajos y Ajustes"
                            Style="{StaticResource ModernBtn}" Height="36" Padding="10,0" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Ayuda" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 2: Rotation Controls (Clean Vector Icons & Proportional Grid) -->
                <Border Margin="0,0,0,10" Background="#1a1a22" BorderBrush="#2e2e3d" BorderThickness="1" CornerRadius="8" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 0° -->
                        <Button x:Name="BtnRot0" Grid.Column="0" Click="BtnRotate0_Click" Style="{StaticResource SegmentBtn}" Margin="0,0,2,0" ToolTip="Normal (0°)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="0°" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- +90° -->
                        <Button x:Name="BtnRotCW" Grid.Column="1" Click="BtnRotateCW_Click" Style="{StaticResource SegmentBtn}" Margin="2,0" ToolTip="Girar 90° en sentido horario (WhatsApp vertical)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M15.55 5.55L11 1v4.07C7.05 5.56 4 8.92 4 13c0 4.42 3.58 8 8 8s8-3.58 8-8h-2c0 3.31-2.69 6-6 6s-6-2.69-6-6c0-2.97 2.16-5.43 5-5.91V12l4.55-4.55a.996.996 0 0 0 0-1.41z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="90°" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 180° -->
                        <Button x:Name="BtnRot180" Grid.Column="2" Click="BtnRotate180_Click" Style="{StaticResource SegmentBtn}" Margin="2,0" ToolTip="Invertir 180°">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M9 3L5 7h3v7h2V7h3L9 3zm6 18l4-4h-3v-7h-2v7h-3l4 4z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="180°" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 270° / -90° -->
                        <Button x:Name="BtnRotCCW" Grid.Column="3" Click="BtnRotateCCW_Click" Style="{StaticResource SegmentBtn}" Margin="2,0,0,0" ToolTip="Girar 270° / -90° (Antihorario)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M8.45 5.55L13 1v4.07C16.95 5.56 20 8.92 20 13c0 4.42-3.58 8-8 8s-8-3.58-8-8h2c0 3.31 2.69 6 6 6s6-2.69 6-6c0-2.97-2.16-5.43-5-5.91V12L8.45 7.45a.996.996 0 0 1 0-1.41z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="270°" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 3: Pin, Interact, Ghost, Window Zen & Fullscreen (With Sharp Modern Vector Icons) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pin Always on Top Toggle -->
                    <Button x:Name="BtnPin" Grid.Column="0" Click="BtnPin_Click" Margin="0,0,2,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Fijar ventana Siempre Encima de las demás">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="IcoPin" Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtPin" Text="Fijo" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Interaction Mode Toggle -->
                    <Button x:Name="BtnInteract" Grid.Column="1" Click="BtnInteract_Click" Margin="2,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Habilitar clics y rueda del ratón en la ventana">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="IcoInteract" Data="M13 2a8 8 0 0 1 8 8v4a8 8 0 0 1-16 0v-4a8 8 0 0 1 8-8zm-1 3v4h2V5h-2z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtInteract" Text="Clics" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Ghost Mode: Hide Original Window Toggle -->
                    <Button x:Name="BtnGhost" Grid.Column="2" Click="BtnGhost_Click" Margin="2,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Ocultar la ventana real (Modo Fantasma)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="IcoGhost" Data="M12 2a9 9 0 0 0-9 9v9l3-2 3 2 3-2 3 2 3-2 3 2V11a9 9 0 0 0-9-9zm-3.5 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm7 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtGhost" Text="Ocultar" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Window Zen Mode (Solo Ventana Limpia y Redimensionable) -->
                    <Button x:Name="BtnWindowZen" Grid.Column="3" Click="BtnWindowZen_Click" Margin="2,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Modo Solo Ventana: quita todos los menús conservando el marco nativo para mover y redimensionar (F10)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M19 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 14H5V8h14v10z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Ventana" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Fullscreen / Monitor Completo Toggle -->
                    <Button x:Name="BtnFullscreen" Grid.Column="4" Click="BtnFullscreen_Click" Margin="2,0,0,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Modo Pantalla Completa: ocupa todo el monitor (F11)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Completa" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 2. Main Rotated Viewport -->
        <Border Grid.Row="1" Background="#060609" ClipToBounds="True">
            <Grid x:Name="ViewportContainer" Background="Transparent"
                  MouseLeftButtonDown="ViewportContainer_MouseLeftButtonDown"
                  MouseLeftButtonUp="ViewportContainer_MouseLeftButtonUp"
                  MouseRightButtonUp="ViewportContainer_MouseRightButtonUp"
                  MouseWheel="ViewportContainer_MouseWheel">

                <!-- Viewbox with smooth scaling -->
                <Viewbox Stretch="Uniform">
                    <Image x:Name="RotatedImageHost" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Viewbox>

                <!-- Floating Fullscreen & Zen HUD Toolbar -->
                <Border x:Name="FullscreenHud"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,16,0"
                        Background="#e6111118"
                        BorderBrush="#40ffffff"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="6,4"
                        Visibility="Collapsed"
                        MouseEnter="FullscreenHud_MouseEnter"
                        MouseLeave="FullscreenHud_MouseLeave"
                        Panel.ZIndex="999">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. Rotate +90° Button -->
                        <Button x:Name="BtnFsRotate" Click="BtnFsRotate_Click" Style="{StaticResource HudBtn}"
                                ToolTip="Girar +90° Horario" Margin="2,0">
                            <Border x:Name="BdFsRotate" Background="#1f1f2e" BorderBrush="#4f46e5" BorderThickness="1" CornerRadius="16" Padding="9,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M15.55 5.55L11 1v4.07C7.05 5.56 4 8.92 4 13c0 4.42 3.58 8 8 8s8-3.58 8-8h-2c0 3.31-2.69 6-6 6s-6-2.69-6-6c0-2.97 2.16-5.43 5-5.91V12l4.55-4.55a.996.996 0 0 0 0-1.41z"
                                          Fill="#a5b4fc" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtFsAngle" Text="90°" FontSize="11" FontWeight="Bold" Foreground="#f4f4f5"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 2. Pin Always on Top -->
                        <Button x:Name="BtnFsPin" Click="BtnPin_Click" Style="{StaticResource HudBtn}"
                                ToolTip="Garantiza que la ventana esté fija encima de todo" Margin="2,0" Width="34" Height="34">
                            <Border x:Name="BdFsPin" Background="#1e1e28" BorderBrush="#383848" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                                <Path x:Name="IcoFsPin" Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"
                                      Fill="#f59e0b" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- 3. Click / Interact Mode -->
                        <Button x:Name="BtnFsInteract" Click="BtnInteract_Click" Style="{StaticResource HudBtn}"
                                ToolTip="Activar / Desactivar Clics e Interacción" Margin="2,0" Width="34" Height="34">
                            <Border x:Name="BdFsInteract" Background="#1e1e28" BorderBrush="#383848" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                                <Path x:Name="IcoFsInteract" Data="M13 2a8 8 0 0 1 8 8v4a8 8 0 0 1-16 0v-4a8 8 0 0 1 8-8zm-1 3v4h2V5h-2z"
                                      Fill="#10b981" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- 4. Ghost Mode -->
                        <Button x:Name="BtnFsGhost" Click="BtnGhost_Click" Style="{StaticResource HudBtn}"
                                ToolTip="Modo Fantasma: Ocultar ventana original" Margin="2,0" Width="34" Height="34">
                            <Border x:Name="BdFsGhost" Background="#1e1e28" BorderBrush="#383848" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                                <Path x:Name="IcoFsGhost" Data="M12 2a9 9 0 0 0-9 9v9l3-2 3 2 3-2 3 2 3-2 3 2V11a9 9 0 0 0-9-9zm-3.5 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm7 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
                                      Fill="#c084fc" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- 5. Toggle Fullscreen / Window Zen -->
                        <Button x:Name="BtnFsToggleMode" Click="BtnFsToggleMode_Click" Style="{StaticResource HudBtn}"
                                Margin="2,0" Width="34" Height="34">
                            <Border x:Name="BdFsToggleMode" Background="#1e1e28" BorderBrush="#383848" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                                <Path x:Name="IcoFsToggleMode" Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
                                      Fill="#cbd5e1" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="18" Fill="#40ffffff" Margin="4,0"/>

                        <!-- 6. Exit to Normal Mode (X) -->
                        <Button x:Name="BtnExitFullscreen" Click="BtnExitFullscreen_Click" Style="{StaticResource HudBtn}"
                                ToolTip="Restaurar menús normales (o pulsa Esc)" Margin="2,0" Width="34" Height="34">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#29181f" BorderBrush="#66f43f5e" BorderThickness="1" CornerRadius="17" Width="34" Height="34" Cursor="Hand">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#fda4af" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#e11d48"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#f43f5e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Placeholder when no window is selected -->
                <Border x:Name="PlaceholderOverlay" Background="#0c0c10" Visibility="Visible" Padding="30">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" Background="#181824" BorderBrush="#2e2e42" BorderThickness="1" CornerRadius="18" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
                                  Fill="#6366f1" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Selecciona una ventana" FontWeight="Bold" FontSize="17" Foreground="#f4f4f5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Elige WhatsApp u otra app en el menú superior para empezar a verla rotada."
                                   FontSize="12" Foreground="#71717a" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,16" TextWrapping="Wrap" MaxWidth="280"/>
                        <Border Background="#1b1b2a" BorderBrush="#312e81" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="#fbbf24" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Atajo global: Ctrl + Alt + R sobre cualquier ventana" FontSize="11" FontWeight="SemiBold" Foreground="#a5b4fc"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Bottom Status Bar -->
        <Border x:Name="FooterBorder" Grid.Row="2" Background="#101015" BorderBrush="#202029" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Listo • Selecciona WhatsApp en el menú superior" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Border Grid.Column="1" Background="#4f46e5" CornerRadius="4" Padding="6,1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAngleBadge" Text="90°" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>

                <TextBlock Text="Atajo: Ctrl + Alt + R" FontSize="10" FontWeight="SemiBold" Foreground="#6366f1" Grid.Column="2" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- 4. Information, Shortcuts & Settings Modal Overlay -->
        <Border x:Name="InfoOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#e009090d"
                Visibility="Collapsed" Panel.ZIndex="2000" Padding="16,14">
            <Border Background="#13131a" BorderBrush="#2e2e40" BorderThickness="1" CornerRadius="14"
                    MaxWidth="480" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.85"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Content -->
                        <RowDefinition Height="*"/>
                        <!-- Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="#181822" BorderBrush="#262635" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                      Fill="#818cf8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Información y Ajustes" FontSize="14" FontWeight="Bold" Foreground="#f4f4f5"/>
                                    <TextBlock Text="AlwaysRotate v3.1 • Guía rápida y atajos" FontSize="11" Foreground="#94a3b8"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Click="BtnCloseInfo_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="28" Height="28" Cursor="Hand" Background="#262635" BorderBrush="#38384d" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
                                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#e11d48"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#f43f5e"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                        <StackPanel Orientation="Vertical">
                            <!-- Section 1: How it works -->
                            <TextBlock Text="FUNCIONAMIENTO GENERAL" FontSize="11" FontWeight="Bold" Foreground="#a5b4fc" Margin="0,0,0,6"/>
                            <Border Background="#1a1a26" BorderBrush="#2e2e42" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                <TextBlock Text="AlwaysRotate captura en tiempo real a 30 FPS cualquier ventana activa de tu sistema (como WhatsApp Desktop) y la gira a 90°, 180° o 270°. Además, reenvía de forma matemática y fluida tus clics y la rueda del ratón a la app original, para que puedas chatear y navegar directamente desde la pantalla rotada."
                                           FontSize="11.5" Foreground="#cbd5e1" TextWrapping="Wrap" LineHeight="17"/>
                            </Border>

                            <!-- Section 2: Shortcuts Cheat Sheet -->
                            <TextBlock Text="ATAJOS DE TECLADO GLOBALES" FontSize="11" FontWeight="Bold" Foreground="#a5b4fc" Margin="0,0,0,6"/>
                            <Border Background="#1a1a26" BorderBrush="#2e2e42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Esc -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="Esc" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Salir de Pantalla Completa o Modo Ventana Zen" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- F10 -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="F10" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Alternar Modo Solo Ventana (sin menús y redimensionable)" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- F11 -->
                                    <Border Grid.Row="2" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="F11" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Alternar Pantalla Completa total (monitor completo)" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- Ctrl + Alt + R -->
                                    <Border Grid.Row="3" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="Ctrl + Alt + R" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Capturar y rotar la ventana activa actual" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- Ctrl + Alt + G -->
                                    <Border Grid.Row="4" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="Ctrl + Alt + G" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Modo Fantasma (ocultar / mostrar ventana original)" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- Ctrl + Alt + Right / Space -->
                                    <Border Grid.Row="5" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="Ctrl+Alt+→ / Espacio" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Rotar +90° en sentido horario al vuelo" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- Ctrl + Alt + P -->
                                    <Border Grid.Row="6" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="Ctrl + Alt + P" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Fijar Always on Top (Siempre encima)" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>

                                    <!-- Alt + Clic -->
                                    <Border Grid.Row="7" Grid.Column="0" Background="#262638" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                        <TextBlock Text="Alt + Clic arrastre" FontSize="10.5" FontWeight="Bold" Foreground="#e0e7ff"/>
                                    </Border>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Mover la ventana libremente desde cualquier punto" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Section 3: Buttons explanation -->
                            <TextBlock Text="ACCIONES Y MODOS" FontSize="11" FontWeight="Bold" Foreground="#a5b4fc" Margin="0,0,0,6"/>
                            <Border Background="#1a1a26" BorderBrush="#2e2e42" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="• 0° / 90° / 180° / 270°: Rotaciones directas en ángulos fijos." FontSize="11" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Fijo (Always on Top): Mantiene AlwaysRotate visible por encima de cualquier otro programa." FontSize="11" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Clics (Interacción): Activa o desactiva el reenvío de clics y rueda a la app original." FontSize="11" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Ocultar (Fantasma): Vuelve 100% invisible la ventana original para no tener duplicados en pantalla." FontSize="11" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Ventana: Oculta los controles conservando el marco nativo para mover y redimensionar con el ratón." FontSize="11" Foreground="#cbd5e1" Margin="0,0,0,5"/>
                                    <TextBlock Text="• Completa: Modo pantalla completa total con HUD flotante que se auto-oculta tras 2.5s." FontSize="11" Foreground="#cbd5e1"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: System Settings -->
                            <TextBlock Text="AJUSTES DEL SISTEMA" FontSize="11" FontWeight="Bold" Foreground="#a5b4fc" Margin="0,0,0,6"/>
                            <Border Background="#1a1a26" BorderBrush="#2e2e42" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox x:Name="ChkAutoStart" Click="ChkAutoStart_Click" Margin="0,0,0,8" Cursor="Hand">
                                        <StackPanel Orientation="Vertical" Margin="4,0,0,0">
                                            <TextBlock Text="Iniciar AlwaysRotate con Windows" FontSize="11.5" FontWeight="SemiBold" Foreground="#f4f4f5"/>
                                            <TextBlock Text="Abre la utilidad automáticamente al encender tu PC" FontSize="10.5" Foreground="#71717a"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="ChkRemember" Click="ChkRemember_Click" Margin="0,4,0,0" Cursor="Hand">
                                        <StackPanel Orientation="Vertical" Margin="4,0,0,0">
                                            <TextBlock Text="Recordar última ventana y rotación" FontSize="11.5" FontWeight="SemiBold" Foreground="#f4f4f5"/>
                                            <TextBlock Text="Restaura la app y el ángulo seleccionados al arrancar" FontSize="10.5" Foreground="#71717a"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Grid.Row="2" Background="#161620" BorderBrush="#262635" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Desarrollado por " FontSize="10.5" Foreground="#71717a" VerticalAlignment="Center"/>
                                <TextBlock Text="Rocaman" FontSize="10.5" FontWeight="Bold" Foreground="#a5b4fc" VerticalAlignment="Center"/>
                                <TextBlock Text=" • rocaman.vercel.app" FontSize="10" Foreground="#6366f1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button Click="BtnCloseInfo_Click" HorizontalAlignment="Right" Style="{StaticResource ModernBtn}" Height="30" Padding="16,0">
                                <TextBlock Text="Cerrar" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
