                            <Border x:Name="BdFsInteract" Background="#1e1e28" BorderBrush="#383848" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                                <Path x:Name="IcoFsInteract" Data="M13 2a8 8 0 0 1 8 8v4a8 8 0 0 1-16 0v-4a8 8 0 0 1 8-8zm-1 3v4h2V5h-2z"
