                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Placeholder when no window is selected -->
                <Border x:Name="PlaceholderOverlay" Background="#0c0c10" Visibility="Visible" Padding="30">
