<Window x:Class="AlwaysRotate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlwaysRotate"
        mc:Ignorable="d"
        Title="AlwaysRotate"
        Icon="app_icon.ico"
        Height="720" Width="480"
        MinHeight="380" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f13"
        Topmost="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Button Base Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e1e26"/>
            <Setter Property="Foreground" Value="#e4e4e7"/>
            <Setter Property="BorderBrush" Value="#333342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d2d3a"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366f1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171720"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Rotation Button -->
        <Style x:Key="SegmentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Completely Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#14141a"/>
            <Setter Property="Foreground" Value="#f4f4f5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252533"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3730a3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="#181820"
                    BorderBrush="#383848"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <!-- Arrow down -->
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="#94a3b8"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#6366f1"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#22222d"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Completely Dark ComboBox ControlTemplate (Fixing White Dropdown Bug) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                <ToggleButton x:Name="toggleButton"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Template="{StaticResource DarkComboBoxToggleButton}"/>
                <ContentPresenter x:Name="contentPresenter"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="12,0,32,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>

                <!-- Deep Dark Popup Container -->
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Slide">
                    <Border x:Name="dropDownBorder"
                            Background="#14141a"
                            BorderBrush="#383848"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,4,0,0"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DropDownScrollViewer"
                                      CanContentScroll="True"
                                      Padding="2">
                            <ItemsPresenter x:Name="ItemsPresenter"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <!-- ComboBox Dark Item Display Template with REAL App Icons -->
        <DataTemplate x:Key="WindowItemTemplate" DataType="{x:Type local:Win32+WindowItem}">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Real Native Application Icon -->
                <Image Grid.Column="0" Source="{Binding RealIcon}" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#262635" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayBadge}" FontSize="9" FontWeight="Bold" Foreground="#a5b4fc"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Viewport -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar Card -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#14141a" BorderBrush="#262633" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel Orientation="Vertical">

                <!-- Row 1: Target Window Selector (Wide & Clean, Auto-Refreshes on Click) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbWindows" Grid.Column="0" Height="36"
                              Template="{StaticResource DarkComboBoxTemplate}"
                              ItemTemplate="{StaticResource WindowItemTemplate}"
                              DropDownOpened="CmbWindows_DropDownOpened"
                              SelectionChanged="CmbWindows_SelectionChanged"
                              Cursor="Hand"/>

                    <Button Grid.Column="1" Click="BtnRefreshWindows_Click" ToolTip="Refrescar lista de ventanas"
                            Style="{StaticResource ModernBtn}" Height="36" Padding="10,0" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Actualizar" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 2: Rotation Segmented Controls & Opacity Slider -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Segmented Rotation Controls -->
                    <Border Grid.Column="0" Background="#1a1a22" BorderBrush="#2e2e3d" BorderThickness="1" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnRot0" Click="BtnRotate0_Click" Style="{StaticResource SegmentBtn}" ToolTip="Normal (0°)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⟲" Margin="0,0,4,0"/>
                                    <TextBlock Text="0° Normal"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRotCW" Click="BtnRotateCW_Click" Style="{StaticResource SegmentBtn}" ToolTip="Girar 90° en sentido horario (WhatsApp vertical)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" Margin="0,0,4,0"/>
                                    <TextBlock Text="+90° Horario"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRot180" Click="BtnRotate180_Click" Style="{StaticResource SegmentBtn}" ToolTip="Invertir 180°">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇅" Margin="0,0,4,0"/>
                                    <TextBlock Text="180°"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRotCCW" Click="BtnRotateCCW_Click" Style="{StaticResource SegmentBtn}" Margin="0" ToolTip="Girar -90° (Antihorario)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺" Margin="0,0,4,0"/>
                                    <TextBlock Text="-90°"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Opacity Slider with percentage badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👁️" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="SliderOpacity" Width="68" Minimum="0.25" Maximum="1.0" Value="1.0"
                                ValueChanged="SliderOpacity_ValueChanged" SmallChange="0.05"
                                VerticalAlignment="Center" ToolTip="Regular opacidad / transparencia"/>
                        <TextBlock x:Name="TxtOpacityVal" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#a5b4fc" Width="34" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Always on Top, Click Interaction, Ghost Original & Fullscreen Mode -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pin Always on Top Toggle -->
                    <Button x:Name="BtnPin" Grid.Column="0" Click="BtnPin_Click" Margin="0,0,3,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Garantiza que AlwaysRotate se quede fija por encima de todos los programas">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="IcoPin" Text="📌" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPin" Text="Fijo (ON)" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Interaction Mode Toggle -->
                    <Button x:Name="BtnInteract" Grid.Column="1" Click="BtnInteract_Click" Margin="3,0,3,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Activa hacer clics y scroll directamente en la ventana rotada">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="IcoInteract" Text="🖱️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtInteract" Text="Interactuar" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Ghost Mode: Hide Original Window Toggle -->
                    <Button x:Name="BtnGhost" Grid.Column="2" Click="BtnGhost_Click" Margin="3,0,3,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Vuelve 100% invisible la ventana original para que solo veas la rotada">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="IcoGhost" Text="👻" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGhost" Text="Ocultar Real" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Fullscreen / Zen Mode Toggle -->
                    <Button x:Name="BtnFullscreen" Grid.Column="3" Click="BtnFullscreen_Click" Margin="3,0,0,0" Height="34"
                            Style="{StaticResource ModernBtn}" ToolTip="Modo Pantalla Completa: quita todos los botones para máxima visión (o pulsa F11)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⛶" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Pantalla" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 2. Main Rotated Viewport -->
        <Border Grid.Row="1" Background="#060609" ClipToBounds="True">
            <Grid x:Name="ViewportContainer" Background="Transparent"
                  MouseLeftButtonDown="ViewportContainer_MouseLeftButtonDown"
                  MouseLeftButtonUp="ViewportContainer_MouseLeftButtonUp"
                  MouseRightButtonUp="ViewportContainer_MouseRightButtonUp"
                  MouseWheel="ViewportContainer_MouseWheel">

                <!-- Viewbox with smooth scaling -->
                <Viewbox Stretch="Uniform">
                    <Image x:Name="RotatedImageHost" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Viewbox>

                <!-- Floating Exit Fullscreen Button (Only Visible in Fullscreen Mode) -->
                <Button x:Name="BtnExitFullscreen" Click="BtnExitFullscreen_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,16,0" Width="38" Height="38"
                        Visibility="Collapsed"
                        ToolTip="Salir de Pantalla Completa (o pulsa Esc)"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#b314141a" CornerRadius="19" BorderBrush="#50ffffff" BorderThickness="1.5">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#f4f4f5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#e11d48"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#f43f5e"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Placeholder when no window is selected -->
                <Border x:Name="PlaceholderOverlay" Background="#0c0c10" Visibility="Visible" Padding="30">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" Background="#181824" CornerRadius="16" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Selecciona una ventana" FontWeight="Bold" FontSize="17" Foreground="#f4f4f5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Elige WhatsApp u otra app en el menú superior para empezar a verla rotada."
                                   FontSize="12" Foreground="#71717a" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,16" TextWrapping="Wrap" MaxWidth="280"/>
                        <Border Background="#1b1b2a" BorderBrush="#312e81" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center">
                            <TextBlock Text="⚡ Atajo global: Ctrl + Alt + R sobre cualquier ventana" FontSize="11" FontWeight="SemiBold" Foreground="#a5b4fc"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Bottom Status Bar -->
        <Border x:Name="FooterBorder" Grid.Row="2" Background="#101015" BorderBrush="#202029" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Listo • Selecciona WhatsApp en el menú superior" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Border Grid.Column="1" Background="#4f46e5" CornerRadius="4" Padding="6,1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAngleBadge" Text="90°" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>

                <TextBlock Text="Atajo: Ctrl + Alt + R" FontSize="10" FontWeight="SemiBold" Foreground="#6366f1" Grid.Column="2" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
