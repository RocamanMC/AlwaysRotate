                            <Border x:Name="BdFsGhost" Background="#1e1e28" BorderBrush="#383848" BorderThickness="1" CornerRadius="17" Width="34" Height="34">
                                <Path x:Name="IcoFsGhost" Data="M12 2a9 9 0 0 0-9 9v9l3-2 3 2 3-2 3 2 3-2 3 2V11a9 9 0 0 0-9-9zm-3.5 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm7 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
